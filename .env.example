# Copy to .env locally. Never use VITE_ for a credential. Never commit .env.
# Python loads this file; the browser only reads public/data/*.json and CSV.
RESEARCH_START=2026-11-09
RESEARCH_END=2026-11-10
# Confirm the right to redistribute source exports before enabling live exports.
SOURCE_REDISTRIBUTION_CONFIRMED=false

# Explorer JWT: request Explorer access through NEAR Intents partner onboarding.
# https://partners.near-intents.org — confirm Explorer scope, not just quote access.
INTENTS_EXPLORER_JWT=
INTENTS_PAGE_SIZE=1000
INTENTS_MAX_PAGES=100
# Bounded probe/export CLI reads this credential locally; never pass it on the command line.
# python scripts/extract_intents.py --start 2026-11-09 --end 2026-11-10

# CoinGecko Developer Dashboard: https://www.coingecko.com/en/developers/dashboard
# demo -> api.coingecko.com / x-cg-demo-api-key; pro -> pro-api / x-cg-pro-api-key
COINGECKO_API_KEY=
COINGECKO_TIER=demo
COINGECKO_INTERVAL_SECONDS=6
COINGECKO_REDISTRIBUTION_CONFIRMED=false

# Google Cloud project with BigQuery API enabled and authorized billing.
# https://console.cloud.google.com/projectcreate
# ADC: gcloud auth application-default login
# Or point GOOGLE_APPLICATION_CREDENTIALS to an authorized local ADC/service-account
# file OUTSIDE this repository. Do not paste JSON into this setting.
BIGQUERY_PROJECT_ID=falcora-test
GOOGLE_CLOUD_PROJECT=falcora-test
GOOGLE_APPLICATION_CREDENTIALS=
# Regional dataset location; US multi-region is not interchangeable with us-east1.
BIGQUERY_LOCATION=us-east1
BIGQUERY_MAX_BYTES_BILLED=100000000
BIGQUERY_TOTAL_BYTES_LIMIT=1000000000
# Provider hard ceilings cannot be raised above these values through configuration.
BIGQUERY_ALLOW_PAID_QUERIES=false
# Discover schemas first: python scripts/rebuild.py --mode discover
# Configure ONLY observed columns. Mapping keys are application roles, values are
# real source column names. id may be a list for a composite action identity.
# See docs/data-sources.md. Empty mapping intentionally rejects data extraction.
BIGQUERY_COLUMN_MAP={}
BIGQUERY_FUNCTION_CALL_VALUE=
BIGQUERY_ACTION_GRAIN_CONFIRMED=false
